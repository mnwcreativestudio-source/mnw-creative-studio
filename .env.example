# Supabase Configuration
# Required for MNW Creative Studio Contact & Inquiry Form
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend API Configuration (Server-Side Secret - Never Expose to Frontend)
# Required for sending real email verification OTP codes
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="MNW Creative Studio <contact@mnwcreativestudio.in>"

# Razorpay Configuration (Server-Side Credentials)
# Required for creating orders and verifying payment signatures
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

